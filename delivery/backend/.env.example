PORT=5185
AUTH_SERVICE_URL=http://localhost:5180
AUTH_SYSTEM_KEY=delivery
AUTH_COOKIE_NAME=juxin_auth_token
AUTH_FETCH_TIMEOUT_MS=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=delivery_user
MYSQL_PASSWORD=change_me_delivery_mysql_password
MYSQL_DATABASE=juxin_delivery
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me_mysql_root_password

CORS_ORIGINS=http://localhost:18084,http://127.0.0.1:18084
DASHBOARD_OVERDUE_DAYS=3
SLA_AUTO_RUN_INTERVAL_MS=300000
MAX_BATCH_STAGE_JOB_IDS=200
MAX_IMPORT_ROWS=500
UPLOAD_ROOT=./uploads/delivery
UPLOAD_MAX_FILE_SIZE_MB=10
