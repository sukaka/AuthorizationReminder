# Root Docker Compose environment template
#
# Usage:
#   cp .env.example .env
#   vi .env
#   ./scripts/deploy/docker-compose-aliyun.sh up -d --build
#
# Optional Aliyun image source prefixes:
# If you have mirrored upstream images into Aliyun ACR, set the prefixes below.
# The wrapper script probes Aliyun candidates first and falls back to official images
# automatically when a candidate image cannot be resolved.
ALIYUN_DOCKERHUB_PREFIX=
ALIYUN_ONLYOFFICE_PREFIX=
ALIYUN_CONFLUENTINC_PREFIX=
ALIYUN_PROVECTUSLABS_PREFIX=

# Public hostname or IP used for browser access in non-local deployments.
# Do not include protocol or port. Examples: localhost, 8.141.81.201, app.example.com
PUBLIC_HOST=localhost

# Go module download path for CMDB builds.
GO_MODULE_PROXY=https://mirrors.aliyun.com/goproxy/,direct
GO_CHECKSUM_DB=sum.golang.google.cn

#
# Shared MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_SHARED_APP_PASSWORD=change_me_shared_app_mysql_password

# Auth
AUTH_MYSQL_PASSWORD=change_me_auth_mysql_password
AUTH_JWT_SECRET=change_me_auth_jwt_secret_64_chars
AUTH_AUDIT_SIGNING_KEY=change_me_auth_audit_signing_key_64_chars
AUTH_CONFIG_SECRET_KEY=change_me_auth_config_secret_key_64_chars
AUTH_BUILTIN_ACCOUNT_DEFAULT_PASSWORD=change_me_builtin_account_default_password
# For plain HTTP deployments keep the two settings below as false.
# For HTTPS deployments set both to true so auth cookies are sent securely and strict startup checks stay enabled.
AUTH_COOKIE_SECURE=false
AUTH_SECURITY_STRICT_MODE=false

# FAQ
FAQ_MYSQL_PASSWORD=change_me_faq_mysql_password
# FAQ and Tender currently share the same OnlyOffice JWT secret.
FAQ_DOC_EDITOR_JWT_SECRET=change_me_faq_onlyoffice_jwt_secret

# Sec Impl
SEC_IMPL_MYSQL_PASSWORD=change_me_sec_impl_mysql_password

# Tender
TENDER_MYSQL_PASSWORD=change_me_tender_mysql_password

# Train Exam
TRAIN_EXAM_MYSQL_PASSWORD=change_me_train_exam_mysql_password
TRAIN_EXAM_AUDIT_SIGNING_KEY=change_me_train_exam_audit_signing_key_64_chars
# Train Exam uses its own OnlyOffice instance and should use a different JWT secret.
TRAIN_EXAM_DOC_EDITOR_JWT_SECRET=change_me_train_exam_onlyoffice_jwt_secret

# CMDB
CMDB_MYSQL_PASSWORD=change_me_cmdb_mysql_password
