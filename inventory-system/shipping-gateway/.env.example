PORT=5190

# Optional gateway auth for inventory-api
SHIPPING_GATEWAY_TOKEN=inventory-shipping-gateway-dev-token
SHIPPING_GATEWAY_TIMEOUT_MS=8000
TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183,http://localhost:18082,http://127.0.0.1:18082
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=240

# Provider adapters (set to your own provider proxy URL or official API URL)
CAINIAO_TRACKING_API_URL=
CAINIAO_TRACKING_API_TOKEN=
CAINIAO_TRACKING_TIMEOUT_MS=8000
CAINIAO_APP_KEY=
CAINIAO_APP_SECRET=

SF_TRACKING_API_URL=
SF_TRACKING_API_TOKEN=
SF_TRACKING_TIMEOUT_MS=8000
SF_CUSTOMER_CODE=
SF_CHECKWORD=

JD_TRACKING_API_URL=
JD_TRACKING_API_TOKEN=
JD_TRACKING_TIMEOUT_MS=8000
JD_APP_KEY=
JD_APP_SECRET=

# Optional: allow mock timeline when provider API URL not configured (0/1)
SHIPPING_GATEWAY_ALLOW_MOCK=0
