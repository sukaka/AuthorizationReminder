PORT=5183
AUTH_SERVICE_URL=http://localhost:5180
AUTH_SYSTEM_KEY=inventory
AUTH_FETCH_TIMEOUT_MS=5000
AUTH_COOKIE_NAME=juxin_auth_token

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=juxin
MYSQL_PASSWORD=change_me_shared_app_mysql_password
MYSQL_DATABASE=juxin_inventory

# Use admin credential to auto-create inventory db and grant permissions.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me_mysql_root_password

CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300

# Shipping alert threshold (hours)
SHIPPING_PENDING_TIMEOUT_HOURS=24
SHIPPING_TRANSIT_TIMEOUT_HOURS=72
SHIPPING_ALERT_REPEAT_HOURS=24

# Reminder linkage database (same MySQL instance, different schema)
MYSQL_REMINDER_DATABASE=juxin_reminder
REMINDER_ALERT_WEBHOOK=
REMINDER_ALERT_WEBHOOK_TOKEN=
REMINDER_WEBHOOK_TIMEOUT_MS=5000

# Optional third-party tracking API (recommended: shipping-gateway service)
# Docker compose example:
# SHIPPING_TRACKING_API_URL=http://shipping-gateway:5190/api/track/query
# SHIPPING_TRACKING_API_TOKEN=inventory-shipping-gateway-dev-token
SHIPPING_TRACKING_API_URL=
SHIPPING_TRACKING_API_TOKEN=
SHIPPING_TRACKING_API_TIMEOUT_MS=6000

# Optional automatic live sync task for in-transit shipments
SHIPPING_TRACKING_AUTO_SYNC_ENABLED=1
SHIPPING_TRACKING_AUTO_SYNC_INTERVAL_MS=300000
SHIPPING_TRACKING_AUTO_SYNC_BATCH=30
