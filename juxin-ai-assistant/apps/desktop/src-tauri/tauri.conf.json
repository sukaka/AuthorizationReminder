{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聚信 AI 助手",
  "version": "1.0.0",
  "identifier": "com.juxin.ai-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:18093",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "聚信 AI 助手",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "url": "https://ai-assistant.invalid"
      }
    ],
    "security": {
      "capabilities": ["remote-main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
