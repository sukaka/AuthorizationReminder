# Unified authentication
AUTH_SERVICE_URL=http://auth:5180
AUTH_SYSTEM_KEY=big-screen

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=juxin_big_screen
MYSQL_USER=big_screen_user
MYSQL_PASSWORD=replace-with-runtime-secret

# Source services
SCA_API_URL=http://sca-api:5191
TRAIN_EXAM_API_URL=http://train-exam-api:5188
REMINDER_API_URL=http://reminder-api:5179

# Signed offline resource packs
BIG_SCREEN_ASSETS_ROOT=/app/assets
BIG_SCREEN_RESOURCE_PUBLIC_KEY=replace-with-ed25519-public-key

# Optional online enhancement. HTTPS origins only; empty keeps strict offline mode.
BIG_SCREEN_EXTERNAL_ORIGIN_ALLOWLIST=
