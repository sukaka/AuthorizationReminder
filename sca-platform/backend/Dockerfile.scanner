FROM anchore/syft:v1.45.1 AS syft
FROM aquasec/trivy:0.71.0 AS trivy
FROM opensca/opensca-cli@sha256:4de6af4bc2a2c33586ce471c62b85db66815f17a9dff51eb2c9423025c86829d AS opensca
FROM owasp/dependency-check:12.1.9 AS dependency_check

ARG PYTHON_BASE_IMAGE=ccr.ccs.tencentyun.com/library/python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

ARG DEBIAN_APT_MIRROR=http://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN set -eux; \
    . /etc/os-release; \
    debian_codename="${VERSION_CODENAME:-bookworm}"; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      printf '%s\n' \
        'Types: deb' \
        "URIs: ${DEBIAN_APT_MIRROR}" \
        "Suites: ${debian_codename} ${debian_codename}-updates" \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        '' \
        'Types: deb' \
        "URIs: ${DEBIAN_SECURITY_MIRROR}" \
        "Suites: ${debian_codename}-security" \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/debian.sources; \
    else \
      printf 'deb %s %s main\ndeb %s %s-updates main\ndeb %s %s-security main\n' \
        "${DEBIAN_APT_MIRROR}" "${debian_codename}" \
        "${DEBIAN_APT_MIRROR}" "${debian_codename}" \
        "${DEBIAN_SECURITY_MIRROR}" "${debian_codename}" \
        > /etc/apt/sources.list; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates git default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=syft /syft /usr/local/bin/syft
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=opensca /app/opensca-cli /usr/local/bin/opensca
COPY --from=dependency_check /usr/share/dependency-check /opt/dependency-check
COPY dependency-check-suppression.xml /etc/dependency-check/suppression.xml

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
RUN adduser --disabled-password --gecos "" appuser \
    && mkdir -p /data/sca/uploads /data/sca/reports /data/sca/sbom /data/sca/backups /data/scanner-results/dependency-check /data/trivy-cache /data/dependency-check \
    && chown -R appuser:appuser /data/sca /data/scanner-results /data/trivy-cache /data/dependency-check \
    && chmod +x /usr/local/bin/syft /usr/local/bin/trivy /usr/local/bin/opensca /opt/dependency-check/bin/dependency-check.sh
USER appuser

CMD ["celery", "-A", "app.celery_app.celery_app", "worker", "--loglevel=INFO", "--queues=scanner,celery"]
