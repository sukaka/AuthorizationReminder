# 聚信软件成分分析平台环境变量模板

APP_NAME=聚信软件成分分析平台
APP_ENV=dev
APP_VERSION=5.64.2
API_PORT=5191
WEB_PORT=18089

# PostgreSQL
POSTGRES_HOST=sca-postgres
POSTGRES_PORT=5432
POSTGRES_DB=juxin_sca
POSTGRES_USER=sca_user
POSTGRES_PASSWORD=change_me_sca_postgres_password
DATABASE_URL=postgresql+psycopg://sca_user:change_me_sca_postgres_password@sca-postgres:5432/juxin_sca

# Redis / Celery
REDIS_HOST=sca-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://sca-redis:6379/0
CELERY_BROKER_URL=redis://sca-redis:6379/1
CELERY_RESULT_BACKEND=redis://sca-redis:6379/2

# 统一登录平台
AUTH_SERVICE_URL=http://host.docker.internal:5180
AUTH_SYSTEM_KEY=sca
AUTH_COOKIE_NAME=juxin_auth_token
AUTH_FETCH_TIMEOUT_MS=5000
AUTH_DEV_BYPASS=false
CORS_ORIGINS=http://localhost:18089,http://127.0.0.1:18089
UPLOAD_ROOT=/data/sca/uploads
CELERY_TASK_ALWAYS_EAGER=false
OSV_API_URL=https://api.osv.dev
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
GITHUB_ADVISORY_URL=https://api.github.com/advisories
GITHUB_TOKEN=
VULNERABILITY_FETCH_TIMEOUT_MS=8000
REPORT_ROOT=/data/sca/reports
SBOM_ROOT=/data/sca/sbom
TOOL_SYFT_PATH=syft
TOOL_TRIVY_PATH=trivy
TOOL_GRYPE_PATH=grype
OPENSCA_ENABLED=true
OPENSCA_PATH=/usr/local/bin/opensca
OPENSCA_TIMEOUT=3600
OPENSCA_OUTPUT_DIR=/data/scanner-results/opensca
SYFT_ENABLED=true
SYFT_PATH=/usr/local/bin/syft
SYFT_TIMEOUT=1800
SYFT_OUTPUT_DIR=/data/scanner-results/syft
SYFT_DEFAULT_FORMATS=cyclonedx-json,spdx-json
TRIVY_ENABLED=true
TRIVY_PATH=/usr/local/bin/trivy
TRIVY_TIMEOUT=3600
TRIVY_CACHE_DIR=/data/trivy-cache
TRIVY_OUTPUT_DIR=/data/scanner-results/trivy
DEPENDENCY_TRACK_ENABLED=true
DEPENDENCY_TRACK_URL=http://dependency-track-apiserver:8080
DEPENDENCY_TRACK_API_KEY=
DEPENDENCY_TRACK_TIMEOUT=1800
DEPENDENCY_TRACK_AUTO_CREATE_PROJECT=true
DEPENDENCY_TRACK_UPLOAD_BOM=true
DEPENDENCY_TRACK_FETCH_FINDINGS=true
DEPENDENCY_TRACK_API_PORT=18090
DEPENDENCY_TRACK_WEB_PORT=18091
DEPENDENCY_TRACK_PUBLIC_API_URL=http://localhost:18090
MULTI_ENGINE_MERGE_ENABLED=true
LOW_CONFIDENCE_AUTO_REVIEW=true
SAVE_RAW_REPORTS=true
RISK_MONITOR_INTERVAL_SECONDS=21600
GITHUB_API_URL=https://api.github.com
MAVEN_SEARCH_URL=https://search.maven.org/solrsearch/select
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_API_URL=https://pypi.org/pypi
GO_PROXY_URL=https://proxy.golang.org
EOL_API_URL=https://endoflife.date/api
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
DEVOPS_BLOCK_SEVERITIES=critical,high
REMEDIATION_OVERDUE_CHECK_SECONDS=3600
PRODUCTION_HTTPS_ENABLED=true
PRODUCTION_JWT_SECURE=true
BACKUP_ROOT=/data/sca/backups

# 前端
VITE_API_BASE=
VITE_SSO_LOGIN_URL=http://localhost:5180/portal?system=sca
