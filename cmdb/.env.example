APP_NAME=cmdb
APP_ENV=dev
HTTP_ADDR=:8088
READ_TIMEOUT_SEC=10
WRITE_TIMEOUT_SEC=15

MYSQL_DSN=cmdb_user:change_me@tcp(127.0.0.1:3306)/cmdb?parseTime=true&charset=utf8mb4,utf8
MYSQL_MAX_OPEN_CONNS=30
MYSQL_MAX_IDLE_CONNS=10

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_CI_CREATED=cmdb.ci.created
KAFKA_TOPIC_CI_UPDATED=cmdb.ci.updated
KAFKA_TOPIC_CI_RELATION_CHANGED=cmdb.ci.relation.changed
KAFKA_TOPIC_CI_DELETED=cmdb.ci.deleted
KAFKA_TOPIC_CI_RECONCILED=cmdb.ci.reconciled

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT_MS=5000

OIDC_ISSUER=https://sso.example.com/realms/main
OIDC_AUDIENCE=cmdb-api
OIDC_JWKS_URL=https://sso.example.com/realms/main/protocol/openid-connect/certs

AUTH_SERVICE_URL=http://127.0.0.1:5180
AUTH_SYSTEM_KEY=cmdb
AUTH_TIMEOUT_MS=5000
AUTH_COOKIE_NAME=juxin_auth_token

BODY_MAX_BYTES=2097152
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
